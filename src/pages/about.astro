---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

/*
	About the artist.

	Built from Jess's own layout file, JESS ELLIOT ABOUT LAYOUT-01.png in the
	ABOUT THE ARTIST folder: portrait left and write-up right, the "works
	across" list tucked under the portrait, then a four-up of working shots,
	then one full-bleed texture to close.

	All the copy on this page is Jess's, from her change document, verbatim.
	The earlier version of this page carried an AI-written draft in her voice;
	that was removed and must not come back. See AGENTS.md.
*/

type ManifestEntry = { file: string; source: string; width: number; height: number };

const files = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/about/*.{jpg,jpeg,png,webp}',
	{ eager: true },
);
const manifests = import.meta.glob<{ default: ManifestEntry[] }>(
	'/src/assets/about/_manifest.json',
	{ eager: true },
);

const entries = manifests['/src/assets/about/_manifest.json']?.default ?? [];
const imageOf = (entry?: ManifestEntry) =>
	entry ? files[`/src/assets/about/${entry.file}`]?.default : undefined;

/*
	The pipeline renames on ingest, so images are found by the original
	filename the manifest keeps in `source`. Jess's layout uses the portrait
	top left, four working shots in the four-up and the texture as the closer;
	her two LAYOUT-0N.png reference files are the layout itself, not content.
*/
const sourceOf = (entry: ManifestEntry) => entry.source.toUpperCase();
const find = (needle: string) => entries.find((e) => sourceOf(e).includes(needle));

const portrait = imageOf(find('ABOUT ME MAIN'));
const closer = imageOf(find('TEXTURE'));

const NOT_CONTENT = ['ABOUT ME MAIN', 'TEXTURE', 'LAYOUT'];
const grid = entries
	.filter((e) => !NOT_CONTENT.some((skip) => sourceOf(e).includes(skip)))
	.map(imageOf)
	.filter((x): x is ImageMetadata => Boolean(x))
	.slice(0, 4);

/*
	Her own list, not the project tag vocabulary — it runs to ten and includes
	Illustration and Graphic Design, which are not things a project is tagged
	with. Deriving it from the services collection would quietly drop those two.
*/
const worksAcross = [
	'Creative Direction',
	'Stage Design',
	'Immersive Installation',
	'Scenic Painting',
	'Props',
	'Set Dec',
	'Decor',
	'Fabrication',
	'Illustration',
	'Graphic Design',
];

const interview =
	'https://www.soundguide.co/news/building-other-worlds-the-art-of-immersive-stage-design-with-jess-elliot';
---

<Base
	title="About the artist"
	description="Jess Elliot is a multidisciplinary South African artist and designer creating spatial environments, immersive installations and visual worlds through physical and digital practices."
	ogImage={portrait?.src}
>
	<article class="about">
		<div class="page top">
			<div class="portrait-col">
				{
					portrait && (
						<Image
							src={portrait}
							alt="Jess Elliot"
							widths={[500, 900, 1300]}
							sizes="(max-width: 860px) 92vw, 41vw"
							loading="eager"
						/>
					)
				}

				<div class="aside-block">
					<h2 class="label">Works across</h2>
					<p>{worksAcross.join(' • ')}</p>
				</div>
			</div>

			<div class="write-up">
				<p class="lede">
					Jess Elliot is a multidisciplinary South African artist and designer creating
					spatial environments, immersive installations and visual worlds through physical
					and digital practices.
				</p>

				<p>
					Her work moves between concept, design and hands-on production, bringing together
					colour, texture, material and form to transform spaces and communicate ideas.
					Working across festivals, cultural spaces, film and collaborative productions
					internationally and in South Africa, her practice spans creative direction, stage
					and spatial design, scenic painting, fabrication, installation, graphic design and
					illustration.
				</p>

				<p>
					Her approach is tactile, adaptive and grounded in experimentation through
					technique, developing projects from early ideas and drawings through to their
					physical or visual realisation. Collaboration is central to this process, working
					alongside artists, designers, fabricators, builders and production teams to shape
					environments and experiences.
				</p>

				<p>
					Across disciplines, her work is connected by her love for storytelling, atmosphere
					and transformation through craft, whether building an immersive space or visually
					communicating through graphics and illustration. Her work invites interaction,
					immersion, curiosity and discovery, creating sensory experiences that are not only
					impactful visually, but entered, embodied, felt.
				</p>

				<p class="interview">
					<a href={interview} rel="noopener">Interviewed by Sound Guide — Building other worlds</a>
				</p>
			</div>
		</div>

		{
			grid.length > 0 && (
				<div class="page grid">
					{grid.map((image) => (
						<figure>
							<Image
								src={image}
								alt=""
								widths={[400, 700, 1000]}
								sizes="(max-width: 860px) 46vw, 23vw"
								loading="lazy"
							/>
						</figure>
					))}
				</div>
			)
		}

		{
			closer && (
				<figure class="closer">
					<Image
						src={closer}
						alt=""
						widths={[900, 1600, 2400]}
						sizes="100vw"
						loading="lazy"
					/>
				</figure>
			)
		}
	</article>
</Base>

<style>
	/* Her layout: portrait a little narrower than the text, a wide gutter
	   between, both columns topped out on the same line. */
	.top {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
		gap: var(--space-9);
		align-items: start;
		padding-block: var(--page-head) var(--section-gap);
	}

	/*
	 * The write-up hangs below the top of the portrait rather than starting
	 * level with it — in Jess's layout the portrait's top edge is the highest
	 * thing on the page and the text drops in beneath by about 7% of the page
	 * width. Ours had the text starting 2.6% *above* the image, which is what
	 * made the pairing read as accidental rather than composed.
	 */
	.write-up {
		padding-top: var(--text-hang);
	}

	.portrait-col :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.aside-block {
		margin-top: var(--space-5);
	}

	.label {
		margin: 0 0 var(--space-2);
		font-family: var(--font-ui);
		font-size: var(--text-micro);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.aside-block p {
		margin: 0;
		font-family: var(--font-ui);
		font-size: var(--text-caption);
		line-height: var(--lh-relaxed);
		color: var(--text-secondary);
	}

	.write-up p {
		margin: 0 0 var(--space-4);
		font-family: var(--font-ui);
		font-size: var(--text-body);
		line-height: var(--lh-relaxed);
		color: var(--text-secondary);
	}

	/* The opening statement is set in caps in her layout, at display size and
	   light weight — it is the one piece of type on the page doing any work. */
	.lede {
		text-transform: uppercase;
		font-size: var(--text-subhead) !important;
		line-height: var(--lh-snug);
		letter-spacing: 0.01em;
		color: var(--text-primary) !important;
		margin-bottom: var(--space-5) !important;
	}

	.interview a {
		color: var(--text-primary);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-3);
		padding-bottom: var(--section-gap);
	}

	.grid figure {
		margin: 0;
	}

	.grid :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 4 / 5;
	}

	/* Runs to both edges of the window, as in her layout — the only full-bleed
	   element on the page, which is what gives it the closing beat. */
	.closer {
		margin: 0;
	}

	/*
	 * A band, not a block. Hers measures 36.9% of the page width; a 70vh cap
	 * made ours 48-58% depending on the window, so the closing image read as
	 * a second hero rather than a full stop. An aspect ratio holds the
	 * proportion at every size, which a viewport-height cap cannot.
	 */
	.closer :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 2.71;
		object-fit: cover;
	}

	@media (max-width: 860px) {
		.top {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}

		/* Stacked, so there is no image to hang from. */
		.write-up {
			padding-top: 0;
		}

		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
