---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { coverFor } from '../lib/gallery';

// A 404 on a portfolio should still show work — no dead end, no apology page.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const covers = projects
	.map((project) => {
		const cover = coverFor(project);
		return cover && { ...cover, project: project.data.title, href: `/projects/${project.id}/` };
	})
	.filter((image) => image !== undefined);
const image = covers[Math.floor(covers.length / 3)] ?? covers[0];
---

<Base title="Not found" description="Page not found.">
	<div class="page notfound">
		<div class="notfound-text">
			<p class="eyebrow">404</p>
			<h1>That page isn't here.</h1>
			<div class="notfound-links">
				<a class="cta" href="/projects/">See the projects</a>
				<a class="secondary" href="/">Back to the beginning</a>
			</div>
		</div>

		{
			image && (
				<a class="notfound-image" href={image.href}>
					<Image src={image.src} alt={image.alt} widths={[500, 900]} sizes="(max-width: 900px) 92vw, 40vw" />
					<span class="caption">{image.project}</span>
				</a>
			)
		}
	</div>
</Base>

<style>
	.notfound {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		gap: var(--gutter-strip);
		align-items: center;
		padding-block: var(--space-10) var(--space-11);
	}

	.notfound-text h1 {
		font-size: var(--text-display);
		margin-block: var(--space-4) var(--space-5);
	}

	.notfound-links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-7);
		margin-top: var(--space-7);
	}

	.secondary {
		font-size: var(--text-caption);
		letter-spacing: var(--track-nav);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.notfound-image {
		text-decoration: none;
		display: block;
	}

	.notfound-image :global(img) {
		width: 100%;
		height: auto;
	}

	.caption {
		display: block;
		padding-top: var(--space-3);
		font-size: var(--text-micro);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.notfound {
			grid-template-columns: 1fr;
			padding-block: var(--space-8);
		}
	}
</style>
