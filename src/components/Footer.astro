---
/*
	The design system's footer: a hairline-topped band with the wordmark set in
	type, the email address as the loudest thing in it, and micro links. Its
	Footer.prompt.md is explicit — "the email is the loudest thing in the footer
	on purpose; don't add a Button here."
*/
const year = new Date().getFullYear();
const email = 'jesselliot7@gmail.com';
const whatsapp = '+27760537689';

const links = [
	{ href: '/about/', label: 'About the artist' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/graphics/', label: 'Graphics' },
	{ href: '/contact/', label: 'Contact' },
];
---

<footer class="site-footer page">
	<div class="footer-band">
		<p class="wordmark">Jess Elliot</p>

		<a class="email" href={`mailto:${email}`}>{email}</a>

		<div class="footer-links">
			<nav aria-label="Footer">
				{links.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>

			{/*
				Jess asked for Instagram and WhatsApp as icons here. Only the
				WhatsApp number has been supplied — the Instagram handle is still
				outstanding, and a guessed profile URL on a live portfolio could
				point at a stranger, so that icon is held back rather than
				invented. Add it to `socials` when she sends it.
			*/}
			<ul class="socials">
				<li>
					<a href={`https://wa.me/${whatsapp.replace(/[^0-9]/g, '')}`} rel="noopener">
						<span class="visually-hidden">WhatsApp</span>
						<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
							<path
								fill="currentColor"
								d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.24-8.23a8.18 8.18 0 0 1 5.82 2.41 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.21-8.24 8.21Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.22.25-.85.84-.85 2.05s.87 2.37.99 2.53c.12.17 1.71 2.62 4.15 3.67.58.25 1.03.4 1.39.51.58.19 1.11.16 1.53.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
							></path>
						</svg>
					</a>
				</li>
			</ul>
		</div>
	</div>

	<p class="colophon">{year} Jess Elliot, All rights reserved</p>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-11);
		padding-block: var(--space-9) var(--space-6);
		border-top: var(--border-hair);
	}

	.footer-band {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--space-6);
	}

	.wordmark {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-subhead);
		text-transform: uppercase;
		letter-spacing: var(--track-nav);
		line-height: 1.06;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-3);
	}

	.socials {
		display: flex;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border: var(--border-hair);
		border-radius: 50%;
		color: var(--text-secondary);
		transition: color var(--dur-1) var(--ease-drift);
	}

	.socials a:hover {
		color: var(--text-primary);
	}

	.email {
		font-family: var(--font-display);
		font-size: var(--text-heading);
		letter-spacing: 0.01em;
		text-decoration: none;
	}

	.footer-band nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
	}

	.footer-band nav a {
		font-size: var(--text-micro);
		text-transform: uppercase;
		letter-spacing: var(--track-label);
		color: var(--text-muted);
		text-decoration: none;
		transition: color var(--dur-1) var(--ease-drift);
	}

	.footer-band nav a:hover {
		color: var(--text-primary);
	}

	.colophon {
		margin: var(--space-8) 0 0;
		font-size: var(--text-micro);
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--text-muted);
	}
</style>
