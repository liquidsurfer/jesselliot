{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jesselliot",
	"compatibility_date": "2026-08-27",

	// Workers static assets, not Pages. Cloudflare's own docs steer new projects
	// away from Pages, and Pages gets no new features.
	//
	// A request that matches a built file is served straight from assets without
	// invoking the Worker. Only requests that match nothing reach worker/index.ts
	// — which means POST /api/enquiry, and anything genuinely missing.
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		// Only meaningful because `main` is set; it is how the Worker hands a
		// request back to the asset server.
		"binding": "ASSETS",
		// Serve dist/404.html (built from src/pages/404.astro) rather than
		// Cloudflare's default 404. Must be explicit on Workers — unlike Pages,
		// nothing is inferred from the presence of a 404.html.
		"not_found_handling": "404-page"
	},

	"observability": {
		"enabled": true
	}
}
